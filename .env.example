# Generation backend. Any OpenAI-compatible endpoint works; switching is a .env edit.
#
# LLM_PROVIDER: ollama | dashscope | deepseek | moonshot | zhipu | openai
#
# --- offline default: no key, no account, no card -------------------------------
LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
#
# --- hosted variants (uncomment one and add the key) -----------------------------
# LLM_PROVIDER=dashscope
# QWEN_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-key-here
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# Optional overrides (defaults shown)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# RETRIEVE_K=8
# CONTEXT_K=4
# MMR_LAMBDA=0.7
# LLM_TIMEOUT=300
# LLM_MAX_TOKENS=400
# CHROMA_PATH=./chroma_db
# CHROMA_COLLECTION=documents
